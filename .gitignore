# Python キャッシュ
__pycache__/
*.py[cod]

# 仮想環境・テストキャッシュ(内部の.gitignore頼みにしない)
.venv/
.pytest_cache/

# 秘密情報の保険(現状は未使用だが事故防止)
.env
.env.*

# テスト用に生成した素材・出力
test/

# 個人メディアの事故防止ネット(置き忘れても拾わない)
*.mp4
*.mov
*.wav
*.mp3
*.srt
# ただしドキュメント用素材は許可
!img/**

# Claude Code のローカル設定(マシン固有の許可設定など)
.claude/settings.local.json

# OS / エディタ
Thumbs.db
.DS_Store
.vscode/
.idea/

# Codex / Superpowers のローカル作業領域
.worktrees/
.superpowers/
